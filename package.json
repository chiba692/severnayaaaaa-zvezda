<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#14221d"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><link rel="manifest" href="/admin-manifest.webmanifest"><link rel="icon" href="/icons/admin-icon-192.png"><title>Северная звезда — Администратор</title>
<style>
:root{--ink:#18231f;--muted:#6c7a73;--mint:#1dbb89;--mint2:#0c926c;--lav:#8275e9;--red:#d85a4e;--amber:#e4a527;--line:#e3ebe6;--bg:#f3f8f5;--card:#fff;--shadow:0 16px 50px rgba(26,57,45,.08)}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 0 0,#dff8ed,transparent 26%),radial-gradient(circle at 100% 0,#ece8ff,transparent 26%),var(--bg);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);min-height:100vh}button,input,select,textarea{font:inherit}a{color:inherit;text-decoration:none}.shell{max-width:1220px;margin:auto;padding:16px}.login{max-width:430px;margin:10vh auto;background:rgba(255,255,255,.9);border:1px solid #fff;backdrop-filter:blur(18px);border-radius:30px;padding:28px;box-shadow:0 30px 90px rgba(30,60,48,.13)}.loginLogo{width:58px;height:58px;border-radius:20px;background:linear-gradient(145deg,#dff8ed,#ece8ff);display:grid;place-items:center;font-size:30px}.login h1{margin:14px 0 5px}.login p{color:var(--muted);margin-top:0}.panel{display:none}.topbar{position:sticky;top:8px;z-index:25;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 14px;border-radius:20px;background:rgba(255,255,255,.82);backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,.95);box-shadow:var(--shadow)}.brand{font-weight:950}.brand small{display:block;color:var(--muted);font-weight:700;font-size:11px}.topActions,.actions,.tabs,.filters,.cardActions{display:flex;gap:7px;flex-wrap:wrap}.btn{border:0;border-radius:12px;padding:10px 13px;font-weight:900;cursor:pointer}.primary{background:linear-gradient(135deg,var(--mint),var(--mint2));color:#fff}.ghost{background:#edf4f0;color:#445249}.danger{background:#fff0ed;color:#ae473c}.purple{background:#efedff;color:#6254c7}.amber{background:#fff6df;color:#94640a}.notifBtn{position:relative}.count{position:absolute;right:-3px;top:-5px;background:#e65348;color:#fff;border:2px solid #fff;border-radius:999px;font-size:10px;min-width:19px;height:19px;display:grid;place-items:center;padding:0 4px}.count:empty{display:none}.hero{display:flex;align-items:end;justify-content:space-between;gap:18px;margin:26px 2px 14px}.hero h1{font-size:34px;letter-spacing:-1.4px;margin:0}.hero p{color:var(--muted);margin:5px 0}.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin:14px 0}.stat{background:rgba(255,255,255,.92);border:1px solid #fff;border-radius:18px;padding:15px;box-shadow:0 8px 28px rgba(30,60,48,.05)}.stat b{font-size:26px}.stat span{display:block;color:var(--muted);font-size:11px;font-weight:800}.tabs{margin:15px 0;overflow:auto;flex-wrap:nowrap;padding-bottom:3px}.tab{border:0;background:#fff;border-radius:999px;padding:9px 13px;font-weight:850;white-space:nowrap;cursor:pointer}.tab.on{background:#18231f;color:#fff}.view{display:none}.view.on{display:block}.tools{display:grid;grid-template-columns:1fr auto;gap:9px;margin:12px 0}.input{width:100%;border:2px solid var(--line);border-radius:13px;padding:11px 12px;background:#fff;outline:0}.input:focus{border-color:var(--mint);box-shadow:0 0 0 4px #e5f8f1}.filter{border:0;border-radius:999px;background:#fff;padding:8px 11px;font-size:12px;font-weight:850;cursor:pointer}.filter.on{background:#18231f;color:#fff}.list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.card{background:rgba(255,255,255,.94);border:1px solid #fff;border-radius:22px;padding:17px;box-shadow:0 9px 34px rgba(30,60,48,.06)}.cardTop{display:flex;justify-content:space-between;gap:10px}.name{font-size:18px;font-weight:950}.pet{color:var(--muted);font-size:13px;margin-top:2px}.when{height:max-content;padding:7px 9px;border-radius:11px;background:#efedff;color:#6254c7;font-size:12px;font-weight:900;text-align:right}.badge{display:inline-block;margin-top:9px;padding:5px 8px;border-radius:999px;font-size:11px;font-weight:950}.st-new{background:#fff3d8;color:#94600a}.st-accepted{background:#e4f8f0;color:#087455}.st-arrived,.st-in_progress{background:#efedff;color:#6254c7}.st-completed{background:#eef2f0;color:#55625c}.st-rejected,.st-no_show,.st-cancelled{background:#fff0ed;color:#aa453b}.svc{background:#edf4f0;color:#46544d}.meta{display:grid;gap:6px;margin:12px 0;font-size:13px}.meta a{color:#08785a;font-weight:900}.details,.comment,.adminNote{padding:9px 10px;border-radius:11px;font-size:12px;margin:8px 0}.details{background:#f3f6f4;color:#52605a}.comment{background:#f6f4ff;color:#5f5878}.adminNote{background:#fff7db;color:#795812;border:1px solid #f4e6ae}.cardActions .btn{padding:8px 9px;font-size:11px}.empty{grid-column:1/-1;padding:40px;text-align:center;color:var(--muted);background:#fff;border-radius:20px}.agenda{display:grid;gap:9px}.agendaItem{display:grid;grid-template-columns:72px 1fr auto;align-items:center;gap:11px;background:#fff;border-radius:16px;padding:13px}.agendaTime{font-size:17px;font-weight:950;color:#6254c7}.agendaItem small{color:var(--muted)}.clinicGrid,.petGrid,.siteGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.clinicCard{padding:20px;border-radius:22px;background:linear-gradient(145deg,#18231f,#284a3d);color:#fff}.clinicCard small{color:#bed0c8}.clinicCard .btn{margin-top:10px}.inpatientCard{background:#fff;border-radius:20px;padding:17px}.stayBar{height:8px;background:#e8edf0;border-radius:999px;margin:11px 0;overflow:hidden}.stayBar i{display:block;height:100%;background:linear-gradient(90deg,var(--mint),var(--lav));border-radius:999px}.calendarHead{display:flex;justify-content:space-between;align-items:center;margin:10px 0}.calendar{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.weekday{text-align:center;color:var(--muted);font-size:11px;font-weight:850}.day{min-height:110px;border:1px solid #edf2ef;background:#fff;border-radius:14px;padding:8px;cursor:pointer}.day:hover{box-shadow:0 0 0 2px #dff6ed}.day.muted{opacity:.36}.day.today{box-shadow:0 0 0 2px var(--mint)}.dayNum{font-weight:950}.event{margin-top:5px;padding:4px 6px;border-radius:7px;background:#edf7f3;font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.petCard{background:#fff;border-radius:21px;padding:18px}.petCard h3{margin:0}.petCard p{color:var(--muted);font-size:13px}.metricGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.metric{padding:18px;border-radius:19px;background:#fff}.metric b{font-size:27px}.metric span{display:block;color:var(--muted);font-size:12px}.chart{margin-top:14px;background:#fff;border-radius:22px;padding:20px}.barRow{display:grid;grid-template-columns:130px 1fr 45px;gap:10px;align-items:center;margin:10px 0;font-size:13px}.barTrack{height:10px;background:#edf2ef;border-radius:999px;overflow:hidden}.barFill{height:100%;background:linear-gradient(90deg,var(--mint),var(--lav));border-radius:999px}.notification{display:grid;grid-template-columns:1fr auto;gap:10px;background:#fff;padding:15px;border-radius:17px;margin-bottom:8px}.notification.unread{box-shadow:inset 4px 0 0 var(--mint)}.notification small{color:var(--muted)}.siteCard{background:#fff;border-radius:20px;padding:18px}.siteCard textarea{min-height:90px}.siteCard label{display:block;font-size:11px;font-weight:900;color:var(--muted);margin:9px 0 4px}.toast{position:fixed;z-index:100;left:50%;bottom:24px;transform:translate(-50%,20px);background:#18231f;color:#fff;padding:11px 15px;border-radius:13px;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}dialog{border:0;border-radius:23px;padding:0;width:min(620px,calc(100% - 20px));max-height:92vh;box-shadow:0 30px 100px rgba(0,0,0,.25)}dialog::backdrop{background:rgba(18,29,24,.45);backdrop-filter:blur(4px)}.modal{padding:20px}.modal h2{margin:0 0 12px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.modalFooter{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.error{display:none;background:#fff0ed;color:#a74439;padding:10px;border-radius:11px;margin:8px 0}.historyRow{padding:11px 0;border-bottom:1px solid var(--line)}.historyRow:last-child{border:0}.pushOk{background:#e5f8f0;color:#087455}
@media(max-width:920px){.stats{grid-template-columns:repeat(3,1fr)}.list,.clinicGrid,.petGrid,.siteGrid{grid-template-columns:1fr}.metricGrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.shell{padding:10px}.topbar{top:5px}.topbar .label{display:none}.hero{display:block}.hero h1{font-size:29px}.stats{grid-template-columns:repeat(2,1fr)}.tools{grid-template-columns:1fr}.calendar{gap:3px}.day{min-height:78px;padding:5px}.event{font-size:8px}.weekday{font-size:9px}.agendaItem{grid-template-columns:55px 1fr}.agendaItem .btn{grid-column:2}.grid2{grid-template-columns:1fr}.metricGrid{grid-template-columns:1fr 1fr}.barRow{grid-template-columns:95px 1fr 34px}.cardActions .btn{flex:1}.login{margin-top:7vh}}
</style></head><body>
<div id="loginView" class="shell"><form id="loginForm" class="login"><div class="loginLogo">🐾</div><h1>Северная звезда</h1><p>Рабочая панель клиники</p><div id="loginError" class="error"></div><input id="login" class="input" placeholder="Логин" autocomplete="username" required style="margin-bottom:8px"><input id="password" class="input" type="password" placeholder="Пароль" autocomplete="current-password" required><button id="loginBtn" class="btn primary" style="width:100%;margin-top:9px">Войти</button></form></div>
<div id="panel" class="panel"><div class="shell"><div class="topbar"><div class="brand">🐾 Северная звезда<small>Администратор · Final</small></div><div class="topActions"><button id="pushBtn" class="btn ghost">🔔 <span class="label">Уведомления</span></button><button id="notifTop" class="btn ghost notifBtn">🗂 <span class="label">Центр</span><span id="notifCount" class="count"></span></button><button id="installBtn" class="btn ghost" hidden>📲 <span class="label">Установить</span></button><button id="refreshBtn" class="btn ghost">↻ <span class="label">Обновить</span></button><button id="logoutBtn" class="btn ghost">Выйти</button></div></div>
<div class="hero"><div><h1 id="viewTitle">Заявки</h1><p id="syncText">Загружаем данные…</p></div><button id="addBtn" class="btn primary">＋ Новая запись</button></div>
<div class="stats"><div class="stat"><b id="sAll">0</b><span>Всего записей</span></div><div class="stat"><b id="sNew">0</b><span>Новые</span></div><div class="stat"><b id="sToday">0</b><span>Сегодня</span></div><div class="stat"><b id="sClinic">0</b><span>Сейчас в клинике</span></div><div class="stat"><b id="sInpatient">0</b><span>Стационар</span></div></div>
<div class="tabs" id="tabs"><button class="tab on" data-view="list">Заявки</button><button class="tab" data-view="today">Сегодня</button><button class="tab" data-view="calendar">Календарь</button><button class="tab" data-view="clinic">В клинике</button><button class="tab" data-view="inpatient">Стационар</button><button class="tab" data-view="pets">Питомцы</button><button class="tab" data-view="analytics">Аналитика</button><button class="tab" data-view="notifications">Уведомления</button><button class="tab" data-view="site">Сайт и цены</button></div>

<section id="listView" class="view on"><div class="tools"><input id="search" class="input" placeholder="Поиск: имя, питомец, телефон, услуга…"><div class="filters"><button class="filter on" data-filter="all">Все</button><button class="filter" data-filter="new">Новые</button><button class="filter" data-filter="accepted">Приняты</button><button class="filter" data-filter="arrived">Пришли</button><button class="filter" data-filter="in_progress">На приёме</button><button class="filter" data-filter="completed">Завершены</button><button class="filter" data-filter="cancelled">Отменены</button></div></div><div id="list" class="list"></div></section>
<section id="todayView" class="view"><div id="agenda" class="agenda"></div></section>
<section id="calendarView" class="view"><div class="calendarHead"><button id="prevMonth" class="btn ghost">←</button><strong id="monthLabel"></strong><button id="nextMonth" class="btn ghost">→</button></div><div id="calendar" class="calendar"></div></section>
<section id="clinicView" class="view"><div id="clinicGrid" class="clinicGrid"></div></section>
<section id="inpatientView" class="view"><div id="inpatientGrid" class="clinicGrid"></div></section>
<section id="petsView" class="view"><div class="tools"><input id="petSearch" class="input" placeholder="Найти питомца или владельца"><div></div></div><div id="petGrid" class="petGrid"></div></section>
<section id="analyticsView" class="view"><div id="analytics"></div></section>
<section id="notificationsView" class="view"><div style="display:flex;justify-content:space-between;gap:10px;align-items:center;margin:8px 0 14px"><p style="color:var(--muted);margin:0">Новые заявки останутся здесь, даже если Push был смахнут.</p><button id="markRead" class="btn ghost">Отметить прочитанными</button></div><div id="notifications"></div></section>
<section id="siteView" class="view"><p style="color:var(--muted)">Цены и описания ниже меняются на клиентском сайте без редактирования GitHub.</p><div id="siteGrid" class="siteGrid"></div></section>
</div></div>

<dialog id="editDialog"><form id="editForm" class="modal"><h2 id="modalTitle">Запись</h2><input id="editId" type="hidden"><div class="grid2"><input id="eOwner" class="input" placeholder="Имя владельца" required><input id="ePhone" class="input" placeholder="Телефон" required></div><input id="ePet" class="input" placeholder="Питомец" required><div class="grid2"><select id="ePetSpecies" class="input"><option value="cat">Кошка</option><option value="dog">Собака</option><option value="other">Другой питомец</option></select><input id="ePetAge" class="input" placeholder="Возраст"></div><select id="eService" class="input"></select><div id="adminServiceDetails"></div><div id="regularFields" class="grid2"><input id="eDate" class="input" type="date"><select id="eTime" class="input"><option value="">Выберите время</option></select></div><div id="stayFields" class="grid2" style="display:none"><input id="eStayStart" class="input" type="date"><input id="eStayEnd" class="input" type="date"></div><textarea id="eComment" class="input" rows="3" placeholder="Комментарий клиента"></textarea><textarea id="eAdminNote" class="input" rows="3" placeholder="Внутренняя заметка — клиент её не видит"></textarea><div id="editError" class="error"></div><div class="modalFooter"><button type="button" id="cancelEdit" class="btn ghost">Отмена</button><button class="btn primary">Сохранить</button></div></form></dialog>
<dialog id="historyDialog"><div class="modal"><h2 id="historyTitle">История</h2><div id="historyList"></div><div class="modalFooter"><button id="closeHistory" class="btn ghost">Закрыть</button></div></div></dialog>
<dialog id="dayDialog"><div class="modal"><h2 id="dayTitle">День</h2><div id="dayList" class="agenda"></div><div class="modalFooter"><button id="closeDay" class="btn ghost">Закрыть</button></div></div></dialog>
<div id="toast" class="toast"></div>
<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];let data=[],services=[],filter='all',view='list',calDate=new Date(),installPrompt=null;const seen=new Set(JSON.parse(localStorage.getItem('sz-seen')||'[]'));
const serviceNames={exam:'Осмотр',ultrasound:'УЗИ',xray:'Рентген',vaccination:'Вакцинация',tests:'Анализы',inpatient:'Стационар',other:'Другое'};const serviceIcons={exam:'🩺',ultrasound:'🫧',xray:'🩻',vaccination:'💉',tests:'🧪',inpatient:'🏥',other:'❓'};const statusNames={new:'Новая',accepted:'Принята',arrived:'Пришёл',in_progress:'На приёме',completed:'Завершена',rejected:'Отклонена',no_show:'Не пришли',cancelled:'Отменена клиентом'};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function toast(t){const x=$('#toast');x.textContent=t;x.classList.add('show');setTimeout(()=>x.classList.remove('show'),2200)}function today(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}function speciesText(s){return({cat:'Кошка',dog:'Собака',other:'Другой питомец'})[s]||'—'}function normalize(b){return{...b,status:b.status||'new',service:b.service||'exam',booking_time:String(b.booking_time||'').slice(0,5),service_details:b.service_details||{}}}async function api(url,opt){const r=await fetch(url,opt),d=await r.json().catch(()=>({}));if(r.status===401){showLogin();throw Error('Сессия закончилась')}if(!r.ok)throw Error(d.error||'Ошибка сервера');return d}function showLogin(){$('#panel').style.display='none';$('#loginView').style.display='block'}function showPanel(){$('#loginView').style.display='none';$('#panel').style.display='block'}
function serviceText(s){return services.find(x=>x.service_key===s)?.name||serviceNames[s]||s}function detailText(b){const d=b.service_details||{};if(b.service==='vaccination')return`Вакцинация: ${d.vaccine_type||'не указано'}${d.last_vaccine_date?' · предыдущая '+d.last_vaccine_date:''}`;if(['ultrasound','xray'].includes(b.service)&&d.area)return d.area;if(b.service==='tests')return`Тип: ${d.test_type||'не указано'}`;if(b.service==='inpatient'&&d.care)return`Уход: ${d.care}`;if(b.service==='other'&&d.reason)return d.reason;return''}
async function load(silent=false){try{const d=await api('/.netlify/functions/get-bookings',{cache:'no-store'});data=(d.bookings||[]).map(normalize);showPanel();await loadExtras();renderAll();$('#syncText').textContent='Обновлено '+new Date().toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'});if(!silent)toast('Данные обновлены')}catch(e){if(!silent)toast(e.message)}}
async function loadExtras(){try{const ss=await api('/.netlify/functions/services',{cache:'no-store'});services=ss.services||[]}catch(e){console.warn(e)}}
function activeInpatient(b){return b.service==='inpatient'&&!['completed','rejected','cancelled'].includes(b.status)&&String(b.stay_end||'')>=today()}function renderStats(){$('#sAll').textContent=data.length;$('#sNew').textContent=data.filter(x=>x.status==='new').length;$('#sToday').textContent=data.filter(x=>x.booking_date===today()&&!['rejected','cancelled'].includes(x.status)).length;$('#sClinic').textContent=data.filter(x=>['arrived','in_progress'].includes(x.status)).length;$('#sInpatient').textContent=data.filter(activeInpatient).length;updateUnread()}
function actionButtons(b){if(b.status==='new')return`<button class="btn primary" onclick="setStatus('${b.id}','accepted')">Принять</button><button class="btn danger" onclick="setStatus('${b.id}','rejected')">Отклонить</button>`;if(b.status==='accepted')return`<button class="btn primary" onclick="setStatus('${b.id}','arrived')">✓ Пришёл</button><button class="btn danger" onclick="setStatus('${b.id}','no_show')">Не пришли</button>`;if(b.status==='arrived')return`<button class="btn purple" onclick="setStatus('${b.id}','in_progress')">Начать приём</button>`;if(b.status==='in_progress')return`<button class="btn primary" onclick="setStatus('${b.id}','completed')">Завершить</button>`;return''}
function cardHtml(b){return`<article class="card"><div class="cardTop"><div><div class="name">${esc(b.owner_name||'Без имени')}</div><div class="pet">🐾 ${esc(b.pet||'Питомец')} · ${esc(speciesText(b.pet_species))}${b.pet_age?' · '+esc(b.pet_age):''}</div></div><div class="when">${b.service==='inpatient'?`🏥 ${esc(b.stay_start||b.booking_date)} → ${esc(b.stay_end||'?')}`:`${esc(b.booking_date)} · ${esc(b.booking_time)}`}</div></div><span class="badge st-${esc(b.status)}">${esc(statusNames[b.status]||b.status)}</span> <span class="badge svc">${esc(serviceIcons[b.service]||'🐾')} ${esc(serviceText(b.service))}</span>${b.booking_type==='traumatologist'?' <span class="badge st-arrived">Травматолог</span>':''}<div class="meta"><div>📞 <a href="tel:${esc(b.phone)}">${esc(b.phone||'—')}</a></div></div>${detailText(b)?`<div class="details">${esc(detailText(b))}</div>`:''}${b.comment?`<div class="comment">💬 ${esc(b.comment)}</div>`:''}${b.admin_note?`<div class="adminNote">📝 Только для клиники: ${esc(b.admin_note)}</div>`:''}${b.client_notice?`<div class="details">⚠️ Клиенту показано: ${esc(b.client_notice)}</div>`:''}<div class="cardActions">${actionButtons(b)}<a class="btn ghost" href="tel:${esc(b.phone)}">📞</a>${b.public_token?`<button class="btn ghost" onclick="copyClientLink('${b.public_token}')">🔗 Ссылка клиенту</button>`:''}<button class="btn ghost" onclick="openEdit('${b.id}')">✏️ Изменить</button><button class="btn ghost" onclick="repeatBooking('${b.id}')">↻ Повторить</button><button class="btn ghost" onclick="showHistory('${b.id}')">🕘 История</button><button class="btn ghost" onclick="removeBooking('${b.id}')">🗑</button></div></article>`}
window.copyClientLink=async token=>{const u=location.origin+'/booking.html?t='+encodeURIComponent(token);try{await navigator.clipboard.writeText(u);toast('Ссылка клиенту скопирована')}catch{prompt('Скопируйте ссылку:',u)}};function renderList(){const q=$('#search').value.trim().toLowerCase();const a=data.filter(b=>(filter==='all'||b.status===filter)&&(!q||[b.owner_name,b.pet,b.phone,b.comment,b.admin_note,serviceText(b.service)].join(' ').toLowerCase().includes(q)));$('#list').innerHTML=a.length?a.map(cardHtml).join(''):'<div class="empty">Ничего не найдено 🐾</div>'}
function renderToday(){const a=data.filter(b=>b.booking_date===today()&&!['rejected','cancelled'].includes(b.status)&&b.service!=='inpatient').sort((a,b)=>a.booking_time.localeCompare(b.booking_time));$('#agenda').innerHTML=a.length?a.map(b=>`<div class="agendaItem"><div class="agendaTime">${esc(b.booking_time)}</div><div><b>${esc(b.pet)} · ${esc(serviceText(b.service))}</b><br><small>${esc(b.owner_name)} · ${esc(statusNames[b.status])}</small></div><button class="btn ghost" onclick="openEdit('${b.id}')">Открыть</button></div>`).join(''):'<div class="empty">Сегодня обычных приёмов нет</div>'}
function renderClinic(){const a=data.filter(b=>['arrived','in_progress'].includes(b.status)).sort((a,b)=>a.booking_time.localeCompare(b.booking_time));$('#clinicGrid').innerHTML=a.length?a.map(b=>`<article class="clinicCard"><small>${b.status==='in_progress'?'Сейчас на приёме':'Ожидает приёма'}</small><h2 style="margin:5px 0">${esc(b.pet)}</h2><div>${esc(b.owner_name)} · ${esc(serviceText(b.service))}</div><div style="margin-top:8px;color:#d4e2dc">${esc(b.booking_time)} · ${esc(b.phone)}</div>${b.status==='arrived'?`<button class="btn purple" onclick="setStatus('${b.id}','in_progress')">Начать приём</button>`:`<button class="btn primary" onclick="setStatus('${b.id}','completed')">Завершить</button>`}</article>`).join(''):'<div class="empty">Сейчас отмеченных посетителей нет</div>'}
function daysBetween(a,b){return Math.max(1,Math.round((new Date(b+'T12:00:00')-new Date(a+'T12:00:00'))/86400000)+1)}function renderInpatient(){const a=data.filter(b=>b.service==='inpatient').sort((a,b)=>String(b.stay_start).localeCompare(String(a.stay_start)));$('#inpatientGrid').innerHTML=a.length?a.map(b=>{const active=activeInpatient(b),total=daysBetween(b.stay_start,b.stay_end),passed=Math.max(0,Math.min(total,daysBetween(b.stay_start,today()))),pc=Math.round(passed/total*100);return`<article class="inpatientCard"><div class="cardTop"><div><b style="font-size:19px">🏥 ${esc(b.pet)}</b><div class="pet">${esc(b.owner_name)} · ${esc(b.phone)}</div></div><span class="badge ${active?'st-accepted':'st-completed'}">${active?'В стационаре':esc(statusNames[b.status]||'Запланирован')}</span></div><p><b>${esc(b.stay_start)}</b> → <b>${esc(b.stay_end)}</b></p><div class="stayBar"><i style="width:${active?pc:0}%"></i></div>${detailText(b)?`<div class="details">${esc(detailText(b))}</div>`:''}${b.admin_note?`<div class="adminNote">${esc(b.admin_note)}</div>`:''}<div class="actions"><a class="btn ghost" href="tel:${esc(b.phone)}">Позвонить</a><button class="btn ghost" onclick="openEdit('${b.id}')">Изменить</button>${active?`<button class="btn primary" onclick="setStatus('${b.id}','completed')">Завершить</button>`:''}</div></article>`}).join(''):'<div class="empty">Записей стационара нет</div>'}
function petGroups(){const m=new Map;data.filter(b=>b.phone&&b.pet).forEach(b=>{const key=b.phone.replace(/\D/g,'')+'|'+b.pet.trim().toLowerCase();if(!m.has(key))m.set(key,{key,pet:b.pet,owner:b.owner_name,phone:b.phone,species:b.pet_species,age:b.pet_age,rows:[]});m.get(key).rows.push(b)});return[...m.values()].sort((a,b)=>Math.max(...b.rows.map(x=>+new Date(x.booking_date||0)))-Math.max(...a.rows.map(x=>+new Date(x.booking_date||0))))}function renderPets(){const q=$('#petSearch').value.trim().toLowerCase();const a=petGroups().filter(g=>!q||[g.pet,g.owner,g.phone].join(' ').toLowerCase().includes(q));$('#petGrid').innerHTML=a.length?a.map(g=>{const last=[...g.rows].sort((a,b)=>String(b.booking_date).localeCompare(String(a.booking_date)))[0];return`<article class="petCard"><h3>🐾 ${esc(g.pet)}</h3><p>${esc(speciesText(g.species))}${g.age?' · '+esc(g.age):''}<br>${esc(g.owner)} · ${esc(g.phone)}</p><div class="details">Посещений: ${g.rows.length} · последнее: ${esc(last.booking_date)} · ${esc(serviceText(last.service))}</div><div class="actions"><a class="btn ghost" href="tel:${esc(g.phone)}">Позвонить</a><button class="btn ghost" onclick="showHistory('${last.id}')">История</button><button class="btn primary" onclick="repeatBooking('${last.id}')">Новая запись</button></div></article>`}).join(''):'<div class="empty">Питомцы не найдены</div>'}
function renderAnalytics(){const now=new Date(),ym=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0'),month=data.filter(b=>String(b.booking_date).startsWith(ym)),completed=month.filter(b=>b.status==='completed').length,noShow=month.filter(b=>b.status==='no_show').length,newClients=new Set(month.map(b=>b.phone?.replace(/\D/g,''))).size;const counts={};month.forEach(b=>counts[b.service]=(counts[b.service]||0)+1);const max=Math.max(1,...Object.values(counts));const bars=Object.entries(counts).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`<div class="barRow"><span>${esc(serviceText(k))}</span><div class="barTrack"><div class="barFill" style="width:${Math.round(v/max*100)}%"></div></div><b>${v}</b></div>`).join('')||'<p style="color:var(--muted)">В этом месяце данных пока нет.</p>';$('#analytics').innerHTML=`<div class="metricGrid"><div class="metric"><b>${month.length}</b><span>записей за месяц</span></div><div class="metric"><b>${completed}</b><span>завершено</span></div><div class="metric"><b>${noShow}</b><span>не пришли</span></div><div class="metric"><b>${newClients}</b><span>уникальных телефонов</span></div></div><div class="chart"><h3 style="margin-top:0">Услуги за текущий месяц</h3>${bars}</div>`}
function bookingSeen(id){return seen.has('b:'+String(id))||seen.has(String(id))}function unreadRows(){return data.filter(x=>x.status==='new'&&!bookingSeen(x.id)).map(x=>({kind:'booking',id:x.id}))}function updateUnread(){const n=unreadRows().length;$('#notifCount').textContent=n?n:'';if('setAppBadge'in navigator){n?navigator.setAppBadge(n).catch(()=>{}):navigator.clearAppBadge().catch(()=>{})}}function renderNotifications(){const a=[...data].filter(b=>b.status==='new'||(b.updated_at&&b.updated_at!==b.created_at)).map(b=>({id:b.id,ts:b.updated_at||b.created_at,unread:!bookingSeen(b.id),html:`<b>${b.status==='new'?'Новая заявка':'Изменение'} · ${esc(b.pet)}</b><br><small>${esc(b.owner_name)} · ${esc(serviceText(b.service))} · ${esc(b.booking_date)} ${b.service==='inpatient'?'':esc(b.booking_time)}</small>`})).sort((x,y)=>String(y.ts||'').localeCompare(String(x.ts||''))).slice(0,60);$('#notifications').innerHTML=a.length?a.map(n=>`<div class="notification ${n.unread?'unread':''}"><div>${n.html}</div><button class="btn ghost" onclick="openFromNotification('booking','${n.id}')">Открыть</button></div>`).join(''):'<div class="empty">Уведомлений нет</div>'}

function renderSite(){const a=services.length?services:Object.keys(serviceNames).map((k,i)=>({service_key:k,name:serviceNames[k],icon:serviceIcons[k],price_label:'',description:'',prep:'',enabled:true}));$('#siteGrid').innerHTML=a.map(s=>`<article class="siteCard" data-key="${esc(s.service_key)}"><h3 style="margin-top:0">${esc(s.icon)} ${esc(s.name)}</h3><label>Цена</label><input class="input priceInput" value="${esc(s.price_label)}"><label>Короткое описание</label><textarea class="input descInput">${esc(s.description)}</textarea><label>Подготовка / что взять с собой</label><textarea class="input prepInput">${esc(s.prep)}</textarea><label style="display:flex;gap:8px;align-items:center"><input class="enabledInput" type="checkbox" ${s.enabled?'checked':''}> Показывать услугу на сайте</label><button class="btn primary" onclick="saveService('${esc(s.service_key)}')">Сохранить</button></article>`).join('')}
function ym(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')}function renderCalendar(){const y=calDate.getFullYear(),m=calDate.getMonth();$('#monthLabel').textContent=new Intl.DateTimeFormat('ru-RU',{month:'long',year:'numeric'}).format(calDate);const first=new Date(y,m,1),start=(first.getDay()+6)%7,days=new Date(y,m+1,0).getDate(),prevDays=new Date(y,m,0).getDate();let cells=['Пн','Вт','Ср','Чт','Пт','Сб','Вс'].map(x=>`<div class="weekday">${x}</div>`);for(let i=0;i<42;i++){let n=i-start+1,cm=m,cy=y,muted=false;if(n<1){n=prevDays+n;cm=m-1;muted=true}else if(n>days){n-=days;cm=m+1;muted=true}const d=new Date(cy,cm,n),ds=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'),events=data.filter(b=>b.booking_date===ds&&!['rejected','cancelled'].includes(b.status));cells.push(`<div class="day ${muted?'muted':''} ${ds===today()?'today':''}" onclick="openDay('${ds}')"><div class="dayNum">${n}</div>${events.slice(0,4).map(b=>`<div class="event">${b.service==='inpatient'?'🏥':esc(b.booking_time)} ${esc(b.pet)}</div>`).join('')}${events.length>4?`<div class="event">+${events.length-4}</div>`:''}</div>`)}$('#calendar').innerHTML=cells.join('')}
function renderAll(){renderStats();renderList();renderToday();renderCalendar();renderClinic();renderInpatient();renderPets();renderAnalytics();renderNotifications();renderSite()}
window.setStatus=async(id,status)=>{try{await api('/.netlify/functions/manage-booking',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'status',id,status})});seen.add('b:'+String(id));saveSeen();await load(true);toast('Статус изменён')}catch(e){toast(e.message)}};window.removeBooking=async id=>{if(!confirm('Удалить запись без возможности восстановления?'))return;try{await api('/.netlify/functions/manage-booking',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'delete',id})});await load(true);toast('Запись удалена')}catch(e){toast(e.message)}};
async function loadTimes(date,selected=''){const s=$('#eTime');s.innerHTML='<option value="">Загружаем…</option>';try{const d=await api('/.netlify/functions/get-available-slots?date='+encodeURIComponent(date),{cache:'no-store'}),times=d.slots||[];if(selected&&!times.includes(selected))times.unshift(selected);s.innerHTML='<option value="">Выберите время</option>'+times.map(t=>`<option ${t===selected?'selected':''}>${esc(t)}</option>`).join('')}catch{s.innerHTML='<option value="">Ошибка расписания</option>'}}
function serviceOptions(){const a=services.length?services:Object.keys(serviceNames).map(k=>({service_key:k,name:serviceNames[k]}));$('#eService').innerHTML=a.map(s=>`<option value="${esc(s.service_key)}">${esc(s.name)}</option>`).join('')}function adminDetails(service,d={}){const box=$('#adminServiceDetails');if(service==='vaccination')box.innerHTML=`<div class="grid2"><select id="aVaccineType" class="input"><option value="unknown">Не знаю</option><option value="complex">Комплексная</option><option value="rabies">Бешенство</option><option value="primary">Первая вакцинация</option><option value="revaccination">Ревакцинация</option></select><input id="aLastVaccineDate" class="input" type="date"></div>`;else if(['ultrasound','xray'].includes(service))box.innerHTML='<input id="aArea" class="input" placeholder="Область исследования">';else if(service==='tests')box.innerHTML='<select id="aTestType" class="input"><option value="unknown">Не знаю</option><option value="cbc">Общий анализ крови</option><option value="biochem">Биохимия</option><option value="urine">Анализ мочи</option><option value="other">Другие</option></select>';else if(service==='inpatient')box.innerHTML='<textarea id="aCare" class="input" rows="3" placeholder="Особенности ухода"></textarea>';else if(service==='other')box.innerHTML='<input id="aReason" class="input" placeholder="Что нужно">';else box.innerHTML='';if(service==='vaccination'){if($('#aVaccineType'))$('#aVaccineType').value=d.vaccine_type||'unknown';if($('#aLastVaccineDate'))$('#aLastVaccineDate').value=d.last_vaccine_date||''}if(['ultrasound','xray'].includes(service)&&$('#aArea'))$('#aArea').value=d.area||'';if(service==='tests'&&$('#aTestType'))$('#aTestType').value=d.test_type||'unknown';if(service==='inpatient'&&$('#aCare'))$('#aCare').value=d.care||'';if(service==='other'&&$('#aReason'))$('#aReason').value=d.reason||''}function readDetails(service){if(service==='vaccination')return{vaccine_type:$('#aVaccineType')?.value||'unknown',last_vaccine_date:$('#aLastVaccineDate')?.value||null};if(['ultrasound','xray'].includes(service))return{area:$('#aArea')?.value.trim()||''};if(service==='tests')return{test_type:$('#aTestType')?.value||'unknown'};if(service==='inpatient')return{care:$('#aCare')?.value.trim()||''};if(service==='other')return{reason:$('#aReason')?.value.trim()||''};return{}}function toggleAdminService(d={}){const svc=$('#eService').value,inp=svc==='inpatient';adminDetails(svc,d);$('#regularFields').style.display=inp?'none':'grid';$('#stayFields').style.display=inp?'grid':'none';$('#eDate').required=!inp;$('#eTime').required=!inp;$('#eStayStart').required=inp;$('#eStayEnd').required=inp}
window.openEdit=async id=>{const b=data.find(x=>String(x.id)===String(id));if(!b)return;seen.add('b:'+String(id));saveSeen();serviceOptions();$('#modalTitle').textContent='Изменить запись';$('#editId').value=b.id;$('#eOwner').value=b.owner_name||'';$('#ePhone').value=b.phone||'';$('#ePet').value=b.pet||'';$('#ePetSpecies').value=b.pet_species||'other';$('#ePetAge').value=b.pet_age||'';$('#eService').value=b.service||'exam';$('#eDate').value=b.booking_date||'';$('#eStayStart').value=b.stay_start||'';$('#eStayEnd').value=b.stay_end||'';$('#eComment').value=b.comment||'';$('#eAdminNote').value=b.admin_note||'';toggleAdminService(b.service_details||{});if(b.service!=='inpatient')await loadTimes(b.booking_date,b.booking_time);$('#editDialog').showModal();updateUnread()};function newForm(b=null){serviceOptions();$('#editForm').reset();$('#editId').value='';$('#modalTitle').textContent=b?'Повторная запись':'Новая запись';$('#eOwner').value=b?.owner_name||'';$('#ePhone').value=b?.phone||'';$('#ePet').value=b?.pet||'';$('#ePetSpecies').value=b?.pet_species||'cat';$('#ePetAge').value=b?.pet_age||'';$('#eService').value=b?.service||'exam';toggleAdminService(b?.service_details||{});$('#eTime').innerHTML='<option value="">Сначала выберите дату</option>';$('#editDialog').showModal()}window.repeatBooking=id=>newForm(data.find(x=>String(x.id)===String(id)));$('#addBtn').onclick=()=>newForm();$('#eService').onchange=()=>toggleAdminService({});$('#eDate').onchange=()=>loadTimes($('#eDate').value);$('#cancelEdit').onclick=()=>$('#editDialog').close();
$('#editForm').onsubmit=async e=>{e.preventDefault();$('#editError').style.display='none';const inp=$('#eService').value==='inpatient',svc=$('#eService').value,body={action:$('#editId').value?'edit':'create',id:$('#editId').value||undefined,owner_name:$('#eOwner').value.trim(),phone:$('#ePhone').value.trim(),pet:$('#ePet').value.trim(),pet_species:$('#ePetSpecies').value,pet_age:$('#ePetAge').value.trim(),service:svc,service_details:readDetails(svc),booking_date:inp?$('#eStayStart').value:$('#eDate').value,booking_time:inp?'00:00':$('#eTime').value,stay_start:inp?$('#eStayStart').value:null,stay_end:inp?$('#eStayEnd').value:null,comment:$('#eComment').value.trim(),admin_note:$('#eAdminNote').value.trim()};try{const result=await api('/.netlify/functions/manage-booking',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});$('#editDialog').close();await load(true);toast(result.schedule_changed?'Запись изменена — клиент увидит уведомление':(body.id?'Запись изменена':'Запись создана'))}catch(err){$('#editError').textContent=err.message;$('#editError').style.display='block'}};
window.showHistory=id=>{const b=data.find(x=>String(x.id)===String(id));if(!b)return;const phone=(b.phone||'').replace(/\D/g,''),pet=(b.pet||'').trim().toLowerCase(),h=data.filter(x=>(x.phone||'').replace(/\D/g,'')===phone&&(x.pet||'').trim().toLowerCase()===pet).sort((a,b)=>String(b.booking_date).localeCompare(String(a.booking_date)));$('#historyTitle').textContent=`История: ${b.pet}`;$('#historyList').innerHTML=h.map(x=>`<div class="historyRow"><b>${esc(x.booking_date)} · ${esc(serviceText(x.service))}</b><br><span>${esc(statusNames[x.status]||x.status)} · ${esc(x.owner_name)}</span>${x.comment?`<br><small>${esc(x.comment)}</small>`:''}${x.admin_note?`<div class="adminNote">${esc(x.admin_note)}</div>`:''}</div>`).join('')||'История пуста';$('#historyDialog').showModal()};$('#closeHistory').onclick=()=>$('#historyDialog').close();window.openDay=ds=>{const a=data.filter(b=>b.booking_date===ds&&!['rejected','cancelled'].includes(b.status)).sort((a,b)=>a.booking_time.localeCompare(b.booking_time));$('#dayTitle').textContent=new Date(ds+'T12:00:00').toLocaleDateString('ru-RU',{weekday:'long',day:'numeric',month:'long'});$('#dayList').innerHTML=a.length?a.map(b=>`<div class="agendaItem"><div class="agendaTime">${b.service==='inpatient'?'🏥':esc(b.booking_time)}</div><div><b>${esc(b.pet)} · ${esc(serviceText(b.service))}</b><br><small>${esc(b.owner_name)} · ${esc(statusNames[b.status])}</small></div><button class="btn ghost" onclick="document.querySelector('#dayDialog').close();openEdit('${b.id}')">Открыть</button></div>`).join(''):'<div class="empty">Записей нет</div>';$('#dayDialog').showModal()};$('#closeDay').onclick=()=>$('#dayDialog').close();
function saveSeen(){localStorage.setItem('sz-seen',JSON.stringify([...seen]));updateUnread();renderNotifications()}window.openFromNotification=(kind,id)=>{seen.add('b:'+String(id));saveSeen();openEdit(id)};$('#markRead').onclick=()=>{data.filter(b=>b.status==='new').forEach(b=>seen.add('b:'+String(b.id)));saveSeen();toast('Отмечено как прочитанное')};$('#notifTop').onclick=()=>switchView('notifications');
window.saveService=async key=>{const c=document.querySelector(`.siteCard[data-key="${CSS.escape(key)}"]`);try{await api('/.netlify/functions/services',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({service_key:key,price_label:c.querySelector('.priceInput').value,description:c.querySelector('.descInput').value,prep:c.querySelector('.prepInput').value,enabled:c.querySelector('.enabledInput').checked})});await loadExtras();renderSite();toast('Сайт обновлён')}catch(e){toast(e.message)}};
function switchView(v){view=v;$$('.tab').forEach(x=>x.classList.toggle('on',x.dataset.view===v));$$('.view').forEach(x=>x.classList.toggle('on',x.id===v+'View'));const names={list:'Заявки',today:'Сегодня',calendar:'Календарь',clinic:'Сейчас в клинике',inpatient:'Стационар',pets:'Карточки питомцев',analytics:'Аналитика',notifications:'Центр уведомлений',site:'Сайт и цены'};$('#viewTitle').textContent=names[v]||'Северная звезда';location.hash=v==='list'?'':v;if(v==='notifications')renderNotifications()}$$('.tab').forEach(b=>b.onclick=()=>switchView(b.dataset.view));$('#search').oninput=renderList;$('#petSearch').oninput=renderPets;$$('.filter').forEach(b=>b.onclick=()=>{$$('.filter').forEach(x=>x.classList.remove('on'));b.classList.add('on');filter=b.dataset.filter;renderList()});$('#prevMonth').onclick=()=>{calDate=new Date(calDate.getFullYear(),calDate.getMonth()-1,1);renderCalendar()};$('#nextMonth').onclick=()=>{calDate=new Date(calDate.getFullYear(),calDate.getMonth()+1,1);renderCalendar()};
function urlKeyToUint8Array(base64String){const padding='='.repeat((4-base64String.length%4)%4),base64=(base64String+padding).replace(/-/g,'+').replace(/_/g,'/'),raw=atob(base64);return Uint8Array.from([...raw].map(c=>c.charCodeAt(0)))}async function enablePush(){if(!('serviceWorker'in navigator)||!('PushManager'in window)){toast('Этот браузер не поддерживает Push');return}try{const reg=await navigator.serviceWorker.register('/sw.js'),perm=await Notification.requestPermission();if(perm!=='granted')throw Error('Разрешение на уведомления не выдано');const k=await api('/.netlify/functions/get-vapid-public',{cache:'no-store'});let sub=await reg.pushManager.getSubscription();if(!sub)sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:urlKeyToUint8Array(k.publicKey)});await api('/.netlify/functions/save-push-subscription',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(sub)});$('#pushBtn').classList.add('pushOk');$('#pushBtn').innerHTML='🔔 <span class="label">Push включён</span>';toast('Уведомления включены')}catch(e){toast(e.message)}}$('#pushBtn').onclick=enablePush;
$('#loginForm').onsubmit=async e=>{e.preventDefault();const b=$('#loginBtn'),er=$('#loginError');er.style.display='none';b.disabled=true;b.textContent='Входим…';try{await api('/.netlify/functions/admin-login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({login:$('#login').value,password:$('#password').value})});$('#password').value='';await load(true);const hv=(location.hash||'').slice(1);if(hv)switchView(hv)}catch(x){er.textContent=x.message;er.style.display='block'}finally{b.disabled=false;b.textContent='Войти'}};$('#logoutBtn').onclick=async()=>{await fetch('/.netlify/functions/admin-logout',{method:'POST'});showLogin()};$('#refreshBtn').onclick=()=>load();
window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();installPrompt=e;$('#installBtn').hidden=false});$('#installBtn').onclick=async()=>{if(installPrompt){installPrompt.prompt();await installPrompt.userChoice;installPrompt=null;$('#installBtn').hidden=true}};if('serviceWorker'in navigator)navigator.serviceWorker.register('/sw.js');document.addEventListener('visibilitychange',()=>{if(!document.hidden&&$('#panel').style.display==='block')load(true)});setInterval(()=>{if(!document.hidden&&$('#panel').style.display==='block')load(true)},30000);load(true).then(()=>{const hv=(location.hash||'').slice(1);if(hv&&document.querySelector(`[data-view="${hv}"]`))switchView(hv)});
</script></body></html>
